# api/.env.example
PORT=3000
# Desenvolvimento: MongoDB do docker-compose.yml da raiz (docker compose up -d)
MONGODB_URI=mongodb://localhost:27017/contrataai-dev
JWT_SECRET=change_this_in_production
BCRYPT_SALT_ROUNDS=10
# Origens do front liberadas no CORS, separadas por vírgula (padrão: http://localhost:4200)
CORS_ORIGIN=http://localhost:4200
